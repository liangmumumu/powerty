<Window x:Class="Powerty.App.LookupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="查词结果" Width="760" Height="144"
        SizeToContent="Manual" MinWidth="280" MinHeight="100" MaxWidth="1200" MaxHeight="1060"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid>
        <Border x:Name="RootBorder" CornerRadius="8" Padding="0"
                BorderThickness="1" BorderBrush="#3E3E42" Background="#F21E1E1E">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel x:Name="HeaderRow" Background="Transparent" Margin="12,8,8,2"
                           ToolTip="拖动此顶栏可移动翻译框">
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Width="24" Height="24"
                            Content="✕" FontSize="10" Padding="0" Cursor="Hand"
                            ToolTip="关闭词条浮窗" Click="CloseButton_OnClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Chrome" Background="Transparent" CornerRadius="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Chrome" Property="Background" Value="#3E3E42" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Chrome" Property="Background" Value="#4E4E52" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Foreground>
                            <SolidColorBrush Color="#CCCCCC" />
                        </Button.Foreground>
                    </Button>
                    <TextBlock x:Name="HeaderText" VerticalAlignment="Center" FontSize="11"
                               Foreground="#8A8A8A" Text="查词" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalAlignment="Stretch"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="14,2,10,12" MaxHeight="440">
                    <StackPanel x:Name="ContentStack">
                        <StackPanel x:Name="RetainedPanel" Margin="0,0,0,2" />
                        <StackPanel x:Name="AiPanel" />
                        <StackPanel x:Name="EntriesPanel" />
                        <WrapPanel x:Name="ChipsPanel" Margin="0,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Thumb x:Name="ResizeRightThumb" Width="6" HorizontalAlignment="Right"
               VerticalAlignment="Stretch" Cursor="SizeWE" Opacity="0.55" Tag="Right"
               DragDelta="ResizeThumb_OnDragDelta" DragCompleted="ResizeThumb_OnDragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
        <Thumb x:Name="ResizeBottomThumb" Height="6" HorizontalAlignment="Stretch"
               VerticalAlignment="Bottom" Cursor="SizeNS" Opacity="0.55" Tag="Bottom"
               DragDelta="ResizeThumb_OnDragDelta" DragCompleted="ResizeThumb_OnDragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
        <Thumb x:Name="ResizeThumb" Width="16" Height="16" HorizontalAlignment="Right"
               VerticalAlignment="Bottom" Cursor="SizeNWSE" Opacity="0.65" Tag="Corner"
               DragDelta="ResizeThumb_OnDragDelta" DragCompleted="ResizeThumb_OnDragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Path Data="M0,14 L14,0 M6,14 L14,6" Stroke="#8A8A8A" StrokeThickness="1.4" />
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>
