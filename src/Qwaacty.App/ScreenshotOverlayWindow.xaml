<Window x:Class="Qwaacty.App.ScreenshotOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图翻译"
        WindowStyle="None" AllowsTransparency="True" Background="#55000000"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Cursor="Cross">
    <Grid>
        <Canvas x:Name="OverlayCanvas" Background="Transparent">
            <Rectangle x:Name="SelectionRect" Visibility="Collapsed"
                       Fill="#22FFFFFF" Stroke="#FF3FA7FF" StrokeThickness="1.5" />
        </Canvas>
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0"
                Background="#CC1E1E1E" CornerRadius="6" Padding="16,8"
                BorderBrush="#3E3E42" BorderThickness="1">
            <TextBlock FontSize="13" Foreground="#E0E0E0"
                       Text="拖动框选要翻译的区域 · Esc 或右键取消" />
        </Border>
    </Grid>
</Window>
