<UserControl x:Class="Qwaacty.App.Controls.ColorEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI, Microsoft YaHei UI">
    <StackPanel>
        <DockPanel>
            <Border x:Name="SwatchBorder" DockPanel.Dock="Right" Width="54" Height="28" Margin="8,0,0,0"
                    CornerRadius="4" BorderBrush="#3E3E42" BorderThickness="1" Background="#1E1E1E" />
            <TextBox x:Name="HexTextBox" Style="{StaticResource VsTextBox}"
                     ToolTip="十六进制颜色（#RRGGBB / #AARRGGBB），回车或移开焦点生效；也可直接用下方滑块调节"
                     KeyDown="HexTextBox_OnKeyDown" LostKeyboardFocus="HexTextBox_OnLostFocus" />
        </DockPanel>
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="46" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                       Foreground="{StaticResource VsDimTextBrush}" Text="红" />
            <Slider x:Name="RedSlider" Grid.Row="0" Grid.Column="1" Margin="0,2,8,2"
                    Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True"
                    Style="{StaticResource VsSlider}" ValueChanged="Slider_OnValueChanged" />
            <TextBlock x:Name="RedValueText" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"
                       TextAlignment="Right" FontSize="12" Foreground="{StaticResource VsDimTextBrush}" />
            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                       Foreground="{StaticResource VsDimTextBrush}" Text="绿" />
            <Slider x:Name="GreenSlider" Grid.Row="1" Grid.Column="1" Margin="0,2,8,2"
                    Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True"
                    Style="{StaticResource VsSlider}" ValueChanged="Slider_OnValueChanged" />
            <TextBlock x:Name="GreenValueText" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"
                       TextAlignment="Right" FontSize="12" Foreground="{StaticResource VsDimTextBrush}" />
            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                       Foreground="{StaticResource VsDimTextBrush}" Text="蓝" />
            <Slider x:Name="BlueSlider" Grid.Row="2" Grid.Column="1" Margin="0,2,8,2"
                    Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True"
                    Style="{StaticResource VsSlider}" ValueChanged="Slider_OnValueChanged" />
            <TextBlock x:Name="BlueValueText" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"
                       TextAlignment="Right" FontSize="12" Foreground="{StaticResource VsDimTextBrush}" />
            <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                       Foreground="{StaticResource VsDimTextBrush}" Text="透明" />
            <Slider x:Name="AlphaSlider" Grid.Row="3" Grid.Column="1" Margin="0,2,8,2"
                    Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True"
                    Style="{StaticResource VsSlider}" ValueChanged="Slider_OnValueChanged"
                    ToolTip="不透明度：255 = 完全不透明，0 = 完全透明" />
            <TextBlock x:Name="AlphaValueText" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center"
                       TextAlignment="Right" FontSize="12" Foreground="{StaticResource VsDimTextBrush}" />
        </Grid>
    </StackPanel>
</UserControl>
