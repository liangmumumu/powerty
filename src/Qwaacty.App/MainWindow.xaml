<Window x:Class="Qwaacty.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Qwaacty.App.Controls"
        Title="Qwaacty" Height="760" Width="920"
        MinHeight="620" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Background="{StaticResource WindowBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="168" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="#181818" BorderBrush="{StaticResource VsPanelBorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="12,18">
                <TextBlock Margin="8,0,0,18" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource VsHeadingBrush}" Text="Qwaacty" />
                <Button x:Name="NavigateHomeButton" Height="38" Margin="0,0,0,5"
                        Style="{StaticResource VsButton}" Content="主页" Click="NavigateHomeButton_OnClick" />
                <Button x:Name="NavigateSettingsButton" Height="38"
                        Style="{StaticResource VsButton}" Content="Settings" Click="NavigateSettingsButton_OnClick" />
                <TextBlock Margin="8,20,8,0" FontSize="11" Foreground="{StaticResource VsDimTextBrush}"
                           TextWrapping="Wrap" Text="关闭主窗口后，翻译服务仍在系统托盘运行。" />
            </StackPanel>
        </Border>
        <Grid Grid.Column="1" Margin="18,14,18,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource VsHeadingBrush}"
                                   Text="主页" />
                        <TextBlock Margin="0,5,0,18" FontSize="12.5" Foreground="{StaticResource VsDimTextBrush}"
                                   Text="快速启停翻译模块；所有快捷键和详细选项可在 Settings 中调整。" />
                        <Border Margin="0,0,0,10" Padding="18" Background="{StaticResource VsPanelBrush}"
                                BorderBrush="{StaticResource VsPanelBorderBrush}" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <CheckBox x:Name="TypingCheckBox" FontSize="15" FontWeight="SemiBold"
                                          Style="{StaticResource VsCheckBox}" Content="键入实时翻译"
                                          Checked="TypingCheckBox_OnChanged" Unchecked="TypingCheckBox_OnChanged" />
                                <TextBlock x:Name="TypingHotkeyHint" Margin="24,8,0,0" FontSize="12"
                                           Foreground="{StaticResource VsDimTextBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,0,10" Padding="18" Background="{StaticResource VsPanelBrush}"
                                BorderBrush="{StaticResource VsPanelBorderBrush}" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <CheckBox x:Name="SelectionAutoCheckBox" FontSize="15" FontWeight="SemiBold"
                                          Style="{StaticResource VsCheckBox}" Content="自动划词翻译（拖选即翻译）"
                                          Checked="SelectionAutoCheckBox_OnChanged"
                                          Unchecked="SelectionAutoCheckBox_OnChanged" />
                                <TextBlock x:Name="SelectionAutoHotkeyHint" Margin="24,8,0,0" FontSize="12"
                                           Foreground="{StaticResource VsDimTextBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,0,10" Padding="18" Background="{StaticResource VsPanelBrush}"
                                BorderBrush="{StaticResource VsPanelBorderBrush}" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <CheckBox x:Name="SelectionCheckBox" FontSize="15" FontWeight="SemiBold"
                                          Style="{StaticResource VsCheckBox}" Content="快捷键划词翻译"
                                          Checked="SelectionCheckBox_OnChanged" Unchecked="SelectionCheckBox_OnChanged" />
                                <TextBlock x:Name="SelectionHotkeyHint" Margin="24,8,0,0" FontSize="12"
                                           Foreground="{StaticResource VsDimTextBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,8,0,0" Padding="18" Background="{StaticResource VsPanelBrush}"
                                BorderBrush="{StaticResource VsPanelBorderBrush}" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource VsHeadingBrush}"
                                           Text="AI 接入" />
                                <TextBlock x:Name="AiSummaryTextBlock" Margin="0,8,0,0" FontSize="12"
                                           Foreground="{StaticResource VsDimTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Grid x:Name="SettingsView" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="16"
                        Background="{StaticResource VsPanelBrush}"
                        BorderBrush="{StaticResource VsPanelBorderBrush}" BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource VsHeadingBrush}"
                                   Text="快捷键（关闭窗口后台运行时同样有效）" />
                        <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource VsDimTextBrush}"
                                   Text="键入翻译开关" />
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Width="96" Margin="10,0,0,0"
                                    Style="{StaticResource VsButton}"
                                    Content="应用" Click="ApplyHotkeyButton_OnClick" />
                            <TextBox x:Name="HotkeyTextBox" Style="{StaticResource VsTextBox}" />
                        </DockPanel>
                        <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource VsDimTextBrush}"
                                   Text="快捷键划词触发（选中文字后按键翻译）" />
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Width="96" Margin="10,0,0,0"
                                    Style="{StaticResource VsButton}"
                                    Content="应用" Click="ApplySelectionHotkeyButton_OnClick" />
                            <TextBox x:Name="SelectionHotkeyTextBox" Style="{StaticResource VsTextBox}" />
                        </DockPanel>
                        <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource VsDimTextBrush}"
                                   Text="快捷键划词模块开关" />
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Width="96" Margin="10,0,0,0"
                                    Style="{StaticResource VsButton}"
                                    Content="应用" Click="ApplySelectionToggleHotkeyButton_OnClick" />
                            <TextBox x:Name="SelectionToggleHotkeyTextBox" Style="{StaticResource VsTextBox}" />
                        </DockPanel>
                        <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource VsDimTextBrush}"
                                   Text="自动划词模块开关" />
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Width="96" Margin="10,0,0,0"
                                    Style="{StaticResource VsButton}"
                                    Content="应用" Click="ApplySelectionAutoToggleHotkeyButton_OnClick" />
                            <TextBox x:Name="SelectionAutoToggleHotkeyTextBox" Style="{StaticResource VsTextBox}" />
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Left" Width="150" VerticalAlignment="Center"
                                       Foreground="{StaticResource VsTextBrush}" Text="截图翻译（框选区域）" />
                            <Button DockPanel.Dock="Right" Width="96" Margin="10,0,0,0"
                                    Style="{StaticResource VsButton}"
                                    Content="应用" Click="ApplyScreenshotHotkeyButton_OnClick" />
                            <TextBox x:Name="ScreenshotHotkeyTextBox" Style="{StaticResource VsTextBox}" />
                        </DockPanel>
                        <TextBlock Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource VsDimTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="可使用 Ctrl、Alt、Shift、Win 与一个按键组合。默认组合：键入开关 Ctrl+Alt+Shift+T、手动划词触发 Ctrl+Alt+Shift+D、手动划词开关 Ctrl+Alt+Shift+S、自动划词开关 Ctrl+Alt+Shift+A、截图翻译 Ctrl+Alt+Shift+X。" />
                        <CheckBox x:Name="OnlineCheckBox" Margin="0,12,0,0"
                                  Style="{StaticResource VsCheckBox}"
                                  Content="本地未命中时，允许在线补查（仅发送当前单词/短语或选中的文本）"
                                  Checked="OnlineCheckBox_OnChanged" Unchecked="OnlineCheckBox_OnChanged" />
                        <CheckBox x:Name="StartupCheckBox" Margin="0,10,0,0"
                                  Style="{StaticResource VsCheckBox}"
                                  Content="登录 Windows 时自动启动"
                                  Checked="StartupCheckBox_OnChanged" Unchecked="StartupCheckBox_OnChanged" />
                    </StackPanel>
                </Border>

                <Border Margin="0,10,0,0" Padding="16"
                        Background="{StaticResource VsPanelBrush}"
                        BorderBrush="{StaticResource VsPanelBorderBrush}" BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource VsHeadingBrush}"
                                   Text="浮窗外观" />
                        <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource VsDimTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="浮窗可拖动改变位置，拖动右下角改变大小；音标始终使用清晰字体显示。" />

                        <Border x:Name="PopupPreviewBorder" Margin="0,12,0,0" Padding="14" CornerRadius="8"
                                Background="#1E1E1E" BorderBrush="{StaticResource VsPanelBorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" x:Name="PreviewPhoneticTextBlock"
                                               FontFamily="Segoe UI" FontSize="12.5"
                                               Foreground="#9CDCFE" VerticalAlignment="Center"
                                               Text="美 [hoʊp]  英 [həʊp]" />
                                    <TextBlock x:Name="PreviewWordTextBlock" FontSize="15.5" FontWeight="SemiBold"
                                               Foreground="#FFFFFF" Text="hope" />
                                </DockPanel>
                                <TextBlock x:Name="PreviewGlossTextBlock" Margin="0,6,0,0" FontSize="13.5"
                                           Foreground="#D4D4D4" TextWrapping="Wrap"
                                           Text="n.  希望；期望；信心" />
                                <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource VsDimTextBrush}"
                                           Text="实时预览：随下方字体、字号与不透明度设置即时变化" />
                            </StackPanel>
                        </Border>

                        <DockPanel Margin="0,12,0,0">
                            <TextBlock DockPanel.Dock="Left" Width="72" VerticalAlignment="Center"
                                       Foreground="{StaticResource VsDimTextBrush}" FontSize="12.5" Text="字体" />
                            <ComboBox x:Name="FontComboBox" Height="30" Style="{StaticResource VsComboBox}"
                                      SelectionChanged="FontComboBox_OnSelectionChanged" />
                        </DockPanel>
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Left" Width="72" VerticalAlignment="Center"
                                       Foreground="{StaticResource VsDimTextBrush}" FontSize="12.5" Text="字号" />
                            <TextBlock x:Name="FontSizeValueText" DockPanel.Dock="Right" Width="48"
                                       TextAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{StaticResource VsDimTextBrush}" />
                            <Slider x:Name="FontSizeSlider" Minimum="10" Maximum="24"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Style="{StaticResource VsSlider}"
                                    ValueChanged="FontSizeSlider_OnValueChanged" />
                        </DockPanel>
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Left" Width="72" VerticalAlignment="Center"
                                       Foreground="{StaticResource VsDimTextBrush}" FontSize="12.5" Text="不透明度" />
                            <TextBlock x:Name="OpacityValueText" DockPanel.Dock="Right" Width="48"
                                       TextAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{StaticResource VsDimTextBrush}" />
                            <Slider x:Name="OpacitySlider" Minimum="0.35" Maximum="1.0"
                                    TickFrequency="0.05" Style="{StaticResource VsSlider}"
                                    ValueChanged="OpacitySlider_OnValueChanged" />
                        </DockPanel>
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Left" Width="72" VerticalAlignment="Center"
                                       Foreground="{StaticResource VsDimTextBrush}" FontSize="12.5" Text="窗口尺寸" />
                            <Button DockPanel.Dock="Right" Width="76" Margin="8,0,0,0"
                                    Style="{StaticResource VsButton}" Content="应用"
                                    Click="ApplyPopupLayoutButton_OnClick" />
                            <TextBox x:Name="PopupWidthTextBox" Width="90" Margin="0,0,8,0"
                                     Style="{StaticResource VsTextBox}" ToolTip="宽度（280–1200）" />
                            <TextBox x:Name="PopupHeightTextBox" Width="90" Style="{StaticResource VsTextBox}"
                                     ToolTip="内容高度（40–1000）" />
                        </DockPanel>
                        <TextBlock Margin="0,14,0,0" FontSize="12.5" Foreground="{StaticResource VsDimTextBrush}"
                                   Text="背景颜色（拖动三原色滑块即时预览）" />
                        <local:ColorEditor x:Name="BackgroundColorEditor" Margin="0,6,0,0" />
                        <TextBlock Margin="0,14,0,0" FontSize="12.5" Foreground="{StaticResource VsDimTextBrush}"
                                   Text="正文颜色" />
                        <local:ColorEditor x:Name="TextColorEditor" Margin="0,6,0,0" />
                        <DockPanel Margin="0,12,0,0">
                            <Button DockPanel.Dock="Right" Width="96" Margin="10,0,0,0"
                                    Style="{StaticResource VsButton}" Content="应用配色"
                                    Click="ApplyPopupColorsButton_OnClick" />
                            <TextBlock VerticalAlignment="Center" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource VsDimTextBrush}"
                                       Text="滑块即时预览；「应用配色」立即保存并生效" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Margin="0,10,0,0" Padding="16"
                        Background="{StaticResource VsPanelBrush}"
                        BorderBrush="{StaticResource VsPanelBorderBrush}" BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource VsHeadingBrush}"
                                   Text="划词与兼容模式" />
                        <CheckBox x:Name="AiContextCheckBox" Margin="0,12,0,0"
                                  Style="{StaticResource VsCheckBox}"
                                  Content="AI 增强翻译：划选单词/短语时结合上下文推断词义（需配置 AI 翻译）"
                                  Checked="AiContextCheckBox_OnChanged"
                                  Unchecked="AiContextCheckBox_OnChanged" />
                        <TextBlock Margin="24,6,0,0" FontSize="11.5" Foreground="{StaticResource VsDimTextBrush}"
                                  TextWrapping="Wrap"
                                  Text="开启后，弹窗将 AI 增强译文显示在词库结果上方，结合周围语境推断选中词义。" />
                        <CheckBox x:Name="HotkeyAutoCloseCheckBox" Margin="0,10,0,0"
                                  Style="{StaticResource VsCheckBox}"
                                  Content="快捷键翻译弹窗：松开按键后自动关闭（取消勾选则保持显示，需手动关闭）"
                                  Checked="HotkeyAutoCloseCheckBox_OnChanged"
                                  Unchecked="HotkeyAutoCloseCheckBox_OnChanged" />
                        <TextBlock Margin="24,6,0,0" FontSize="11.5" Foreground="{StaticResource VsDimTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="自动查询的弹窗在点击任意处（取消划词）时自动关闭；快捷键弹窗按上面选项控制：松开按键后自动关闭（至少显示 1.5 秒便于阅读），或保持显示手动关闭。" />
                        <CheckBox x:Name="CompatibilityCheckBox" Margin="0,10,0,0"
                                  Style="{StaticResource VsCheckBox}"
                                  Content="兼容模式：微信/QQ 等无法直接读取的应用改用临时键入缓冲查词"
                                  Checked="CompatibilityCheckBox_OnChanged"
                                  Unchecked="CompatibilityCheckBox_OnChanged" />
                        <TextBlock Margin="24,6,0,0" FontSize="11.5" Foreground="{StaticResource VsDimTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="兼容模式只在内存中保留最近键入的少量字符用于查词，不写入磁盘；切换焦点、回车或点击鼠标即清空。中文输入法组合状态无法支持。微信打字查词必须开启此项。" />
                        <CheckBox x:Name="DiagnosticsCheckBox" Margin="0,10,0,0"
                                  Style="{StaticResource VsCheckBox}"
                                  Content="记录诊断日志（仅事件元数据：应用名/结果/错误，不含任何文本内容）"
                                  Checked="DiagnosticsCheckBox_OnChanged"
                                  Unchecked="DiagnosticsCheckBox_OnChanged" />
                    </StackPanel>
                </Border>

                <Border Margin="0,10,0,0" Padding="16"
                        Background="{StaticResource VsPanelBrush}"
                        BorderBrush="{StaticResource VsPanelBorderBrush}" BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource VsHeadingBrush}"
                                   Text="AI 翻译（可选，云端大模型）" />
                        <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource VsDimTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="本地词库未收录的单词、短语与划词句子交给 AI 翻译（OpenAI 兼容接口，支持 DeepSeek/通义千问/Kimi/豆包等）。只发送当前查询片段（开启「AI 增强翻译」时附带选区前后少量语境，最多 360 字符）；API Key 经 Windows 加密后仅保存在本机。" />
                        <CheckBox x:Name="AiEnabledCheckBox" Margin="0,12,0,0"
                                  Style="{StaticResource VsCheckBox}"
                                  Content="启用 AI 翻译（本地未命中时优先使用 AI）"
                                  Checked="AiEnabledCheckBox_OnChanged"
                                  Unchecked="AiEnabledCheckBox_OnChanged" />
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Left" Width="76" VerticalAlignment="Center"
                                       Foreground="{StaticResource VsDimTextBrush}" FontSize="12.5" Text="服务商" />
                            <ComboBox x:Name="AiPresetComboBox" Height="30" Style="{StaticResource VsComboBox}"
                                      SelectionChanged="AiPresetComboBox_OnSelectionChanged" />
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Left" Width="76" VerticalAlignment="Center"
                                       Foreground="{StaticResource VsDimTextBrush}" FontSize="12.5" Text="接口地址" />
                            <TextBox x:Name="AiBaseUrlTextBox" Style="{StaticResource VsTextBox}"
                                     LostKeyboardFocus="AiField_OnLostFocus" />
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Left" Width="76" VerticalAlignment="Center"
                                       Foreground="{StaticResource VsDimTextBrush}" FontSize="12.5" Text="模型" />
                            <TextBox x:Name="AiModelTextBox" Style="{StaticResource VsTextBox}"
                                     LostKeyboardFocus="AiField_OnLostFocus" />
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Left" Width="76" VerticalAlignment="Center"
                                       Foreground="{StaticResource VsDimTextBrush}" FontSize="12.5" Text="API Key" />
                            <PasswordBox x:Name="AiApiKeyBox" Padding="8,6" VerticalContentAlignment="Center"
                                         Background="{StaticResource VsInputBrush}"
                                         Foreground="{StaticResource VsTextBrush}"
                                         BorderBrush="{StaticResource VsPanelBorderBrush}"
                                         LostKeyboardFocus="AiField_OnLostFocus" />
                        </DockPanel>
                        <DockPanel Margin="0,12,0,0">
                            <Button DockPanel.Dock="Right" x:Name="AiTestButton" Width="110" Margin="10,0,0,0"
                                    Style="{StaticResource VsButton}"
                                    Content="测试连接" Click="AiTestButton_OnClick" />
                            <CheckBox x:Name="AiStreamingCheckBox"
                                      Style="{StaticResource VsCheckBox}"
                                      Content="流式显示（译文逐字出现，更快看到结果）"
                                      Checked="AiStreamingCheckBox_OnChanged"
                                      Unchecked="AiStreamingCheckBox_OnChanged" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

        <Border Grid.Row="1" Margin="0,12,0,0" Padding="12,9"
                Background="{StaticResource VsAccentBrush}" CornerRadius="4">
            <TextBlock x:Name="StatusTextBlock" Foreground="White" FontSize="12.5"
                       TextWrapping="Wrap"
                       Text="正在初始化本地词库…" />
        </Border>
        </Grid>
    </Grid>
</Window>
