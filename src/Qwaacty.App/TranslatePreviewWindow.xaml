<Window x:Class="Qwaacty.App.TranslatePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入转译"
        Width="380" SizeToContent="Height" MaxHeight="240"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Border x:Name="RootBorder" CornerRadius="8" BorderThickness="1" BorderBrush="#3E3E42"
            Background="#F21E1E1E" Padding="14,10">
        <StackPanel>
            <DockPanel>
                <TextBlock x:Name="HotkeyHintText" DockPanel.Dock="Right" FontSize="10.5"
                           VerticalAlignment="Center" Foreground="#858585" />
                <TextBlock FontSize="10.5" VerticalAlignment="Center" Foreground="#858585"
                           Text="输入转译预览" />
            </DockPanel>
            <TextBlock x:Name="SourceText" Margin="0,6,0,0" FontSize="11.5" Foreground="#9C9C9C"
                       TextTrimming="CharacterEllipsis" MaxHeight="17" />
            <TextBlock x:Name="TranslationText" Margin="0,6,0,0" FontSize="14.5" Foreground="#E8E8E8"
                       TextWrapping="Wrap" MaxHeight="130" />
        </StackPanel>
    </Border>
</Window>
